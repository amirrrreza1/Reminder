# Reminder environment template
# Copy to .env, replace every CHANGE_ME value, and never commit the result.

# Application
NODE_ENV=production
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=info

# Notification scheduling in APP_TIMEZONE
NOTIFICATION_SEND_TIME=09:00
NOTIFICATION_POLL_INTERVAL_SECONDS=60
NOTIFICATION_MISSED_GRACE_HOURS=72
NOTIFICATION_MAX_ATTEMPTS=5

# PostgreSQL used by Docker Compose
POSTGRES_DB=reminder
POSTGRES_USER=reminder
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://reminder:CHANGE_ME_DATABASE_PASSWORD@db:5432/reminder

# SMTP. Email stays unavailable until host, recipient, sender, and any
# provider-required authentication values are complete and valid.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Reminder <reminder@example.com>"
EMAIL_TO=

# Telegram. Leave both values empty to make Telegram unavailable in the UI.
# Create the bot with BotFather, message it once, then set the destination chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Initial setting defaults. They seed a new database only; later edits live in DB.
DEFAULT_CALENDAR_SYSTEM=jalali
DEFAULT_CURRENCY=IRR
DEFAULT_EMAIL_ENABLED=false
DEFAULT_TELEGRAM_ENABLED=false
