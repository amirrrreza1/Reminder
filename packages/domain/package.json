{
  "name": "@reminder/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "clean": "rimraf dist",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "devDependencies": {
    "@reminder/eslint-config": "workspace:*",
    "@reminder/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
